# Configuration file for photo upload scripts
# 
# IMPORTANT: AWS credentials are NOT stored here for security.
# Configure AWS credentials using AWS CLI: aws configure
# This will save credentials to ~/.aws/credentials (not in this repo)
#
# This file only contains non-sensitive configuration.
# Copy this to .env and update the values below.

# AWS Region
AWS_REGION=us-west-2

# S3 Bucket Configuration
S3_BUCKET_NAME=your-bucket-name

# CloudFront URL (without trailing slash)
# Use domain URL for consistency (domain routes through CloudFront)
CLOUDFRONT_URL=https://your-domain.com

# Optional: Upload folder configuration
# PHOTOS_FOLDER=photos/originals/


